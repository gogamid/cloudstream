<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryGrayBackground"
    android:orientation="vertical">

    <HorizontalScrollView
        android:id="@+id/discover_filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/discover_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_type"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:nextFocusDown="@id/discover_results"
                tools:text="Movies ▾" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_rating"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:nextFocusDown="@id/discover_results"
                tools:text="7+ ▾" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_genres"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:nextFocusDown="@id/discover_results"
                tools:text="Genres ▾" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_year"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:nextFocusDown="@id/discover_results"
                tools:text="All ▾" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_sort"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:nextFocusDown="@id/discover_results"
                tools:text="Popular ▾" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_reset"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:nextFocusDown="@id/discover_results"
                android:text="@string/discover_reset"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.lagradost.cloudstream3.ui.AutofitRecyclerView
            android:id="@+id/discover_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants"
            android:nextFocusUp="@id/discover_filters"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            tools:listitem="@layout/search_result_grid" />
        <ProgressBar
            android:id="@+id/discover_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@string/loading" />
    </FrameLayout>

    <TextView
        android:id="@+id/discover_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="?attr/textColor"
        android:visibility="gone" />
</LinearLayout>
