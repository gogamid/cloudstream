<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="?attr/primaryGrayBackground"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/preview_poster"
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:layout_marginEnd="16dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
        <ScrollView
            android:id="@+id/preview_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="true"
            android:nextFocusDown="@id/preview_watchlist">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/preview_metadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/textColor"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/preview_overview"
                    style="@style/PreviewDescriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <com.google.android.material.chip.Chip
        android:id="@+id/preview_watchlist"
        style="@style/ChipFilled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="false"
        android:nextFocusUp="@id/preview_scroll"
        android:nextFocusDown="@id/preview_completed"
        app:ensureMinTouchTargetSize="false" />
    <com.google.android.material.chip.Chip
        android:id="@+id/preview_completed"
        style="@style/ChipFilled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="false"
        android:nextFocusUp="@id/preview_watchlist"
        android:nextFocusDown="@id/preview_ignore"
        app:ensureMinTouchTargetSize="false" />
    <com.google.android.material.chip.Chip
        android:id="@+id/preview_ignore"
        style="@style/ChipFilled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="false"
        android:nextFocusUp="@id/preview_completed"
        android:nextFocusDown="@id/preview_search"
        app:ensureMinTouchTargetSize="false" />
    <com.google.android.material.chip.Chip
        android:id="@+id/preview_search"
        style="@style/ChipFilled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="false"
        android:nextFocusUp="@id/preview_ignore"
        android:text="@string/discover_search_providers"
        app:ensureMinTouchTargetSize="false" />
</LinearLayout>
